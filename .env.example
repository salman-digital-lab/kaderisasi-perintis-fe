# Mock API is used while these are empty (no backend needed).
VITE_USE_MOCK_API=true
# Participant API (kaderisasi-web-be-go)
VITE_WEB_API=http://localhost:3333/v2
# Staff API (kaderisasi-admin-be-go)
VITE_ADMIN_API=http://localhost:3334/v2
# Optional, demos only: same RFC 3339 instant as the backends' PERINTIS_CLOCK.
VITE_PERINTIS_CLOCK=
# Google OAuth client (same one as kaderisasi-web-fe and admin-fe); empty hides Google sign-in.
VITE_GOOGLE_CLIENT_ID=
